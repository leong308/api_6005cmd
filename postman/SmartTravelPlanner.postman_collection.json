			"name": "Person 4 - Core Endpoints",
			"item": [
				{
					"name": "Get Country Info - Japan (Success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify country data structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.be.an('object');",
									"    pm.expect(jsonData.data.country).to.eql(\"Japan\");",
									"    pm.expect(jsonData.data.capital).to.eql(\"Tokyo\");",
									"    pm.expect(jsonData.data.currency).to.eql(\"Japanese yen\");",
									"    pm.expect(jsonData.data.languages).to.be.an('array').that.includes(\"Japanese\");",
									"    pm.expect(jsonData.data.region).to.eql(\"Asia\");",
									"    pm.expect(jsonData.data.countryCode).to.eql(\"JP\");",
									"    pm.expect(jsonData.data.flag).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/countries/Japan",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"countries",
								"Japan"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Trip Summary - trip_001 (Success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify summary contains nested details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.tripId).to.eql(\"trip_001\");",
									"    pm.expect(jsonData.data.trip).to.be.an('object');",
									"    pm.expect(jsonData.data.weather).to.be.an('object').or.eql(null);",
									"    pm.expect(jsonData.data.googlePlaces).to.be.an('array');",
									"    pm.expect(jsonData.data.recommendations).to.be.an('array');",
									"    pm.expect(jsonData.data.countryInfo).to.be.an('object');",
									"    pm.expect(jsonData.data.countryInfo.countryCode).to.eql(\"JP\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/trips/trip_001/summary",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"trips",
								"trip_001",
								"summary"
							]
						}
					},
					"response": []
