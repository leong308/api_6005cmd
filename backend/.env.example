# Mapbox (required for map rendering in the Flutter app)
MAPBOX_ACCESS_TOKEN=your_public_mapbox_access_token

# Server Configuration
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_APP_BASE_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local Connection String)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/smart_travel_planner?retryWrites=true&w=majority
MONGO_DB_NAME=smart_travel_planner
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
RECOMMENDATION_EMPTY_CACHE_TTL_MS=900000

# Security & Authentication
# Required in production. Leave blank locally to use an ephemeral development secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=
JWT_AUDIENCE=
EMAIL_VERIFICATION_EXPIRES_IN_MS=7200000
PASSWORD_RESET_EXPIRES_IN_MS=7200000

# Email verification/password reset (Firebase Auth, Render Free compatible)
EMAIL_PROVIDER=firebase
FIREBASE_AUTH_API_KEY=replace_with_your_firebase_web_api_key
FIREBASE_AUTH_REQUEST_TIMEOUT_MS=10000

# Country lookup (Geoapify first, Nominatim only as fallback)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_COUNTRY_CACHE_PRECISION=3
GEOAPIFY_TIMEOUT_MS=12000
NOMINATIM_USER_AGENT=SmartTripPlanner/1.0 (your-email@example.com)

# Weather cache: one JSON file per trip under backend/.data/weather-cache
TRIP_CURRENT_WEATHER_CACHE_TTL_MS=1800000
TRIP_DAILY_FORECAST_CACHE_TTL_MS=21600000
TRIP_STALE_WEATHER_BACKUP_TTL_MS=86400000
WEATHER_PROVIDER_TIMEOUT_MS=12000
OPENWEATHER_API_KEY=replace_with_your_openweather_api_key
MET_NORWAY_USER_AGENT=SmartTripPlanner/1.0 (your-email@example.com)

# Optional Resend fallback. Requires a verified sender domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace_with_your_resend_api_key
# MAIL_FROM="Smart Trip Planner <noreply@your-verified-domain.com>"
# EMAIL_REQUEST_TIMEOUT_MS=10000

# Optional SMTP fallback for local or paid hosting only. Render Free blocks SMTP.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_app_password_here
# MAIL_FROM="Smart Travel Planner <your_email@example.com>"

# Third-Party API Keys (Mandatory for provider-backed places/recommendations)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
FOURSQUARE_API_KEY=your_foursquare_api_key_here
# Optional: set to raw only if your Foursquare key rejects an Authorization: Bearer header
FOURSQUARE_AUTH_SCHEME=
# Optional: override Foursquare Places search endpoint
FOURSQUARE_PLACES_SEARCH_URL=https://places-api.foursquare.com/places/search
# Optional: Foursquare Places API version header
FOURSQUARE_PLACES_API_VERSION=2025-02-05

# Weather API
# Weather provider order: Open-Meteo, OpenWeather, then MET Norway.
# Open-Meteo and MET Norway do not require API keys.
# OpenWeather requires OPENWEATHER_API_KEY.

# Reverse Geocoding (OpenStreetMap Nominatim)
NOMINATIM_USER_AGENT=smart-travel-planner-dev/1.0 (your-email@example.com)


