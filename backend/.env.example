# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local Connection String)
MONGO_URI=mongodb+srv://ynboon04:Vfz0hCQB9yW7ceDn@cluster0.oeel4hf.mongodb.net/smart_travel_planner

# Security & Authentication (Required for JWT implementation)
JWT_SECRET=your_jwt_super_secret_key_here
JWT_EXPIRES_IN=7d

# Third-Party API Keys (Mandatory for provider-backed places/recommendations)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
FOURSQUARE_API_KEY=your_foursquare_api_key_here
# Optional: set to raw only if your Foursquare key rejects an Authorization: Bearer header
FOURSQUARE_AUTH_SCHEME=
# Optional: override Foursquare Places search endpoint
FOURSQUARE_PLACES_SEARCH_URL=https://places-api.foursquare.com/places/search
# Optional: Foursquare Places API version header
FOURSQUARE_PLACES_API_VERSION=2025-02-05

# Weather API
# Open-Meteo is used for weather and does not require an API key.

# Reverse Geocoding (OpenStreetMap Nominatim)
NOMINATIM_USER_AGENT=smart-travel-planner-dev/1.0 (your-email@example.com)


